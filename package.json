{
  "name": "cambrio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && tsup src/server/index.ts --format esm --platform node --target node22 --out-dir dist/server --sourcemap",
    "start": "NODE_ENV=production node dist/server/index.js",
    "start:windows": "set NODE_ENV=production&& node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --no-file-parallelism",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "smoke:reconnect": "node scripts/reconnect-smoke.mjs",
    "smoke:http": "tsx scripts/http-realtime-smoke.ts",
    "stress:socket": "node scripts/socket-load-smoke.mjs",
    "stress:actions": "node scripts/action-spam-smoke.mjs",
    "audit:eight": "node scripts/eight-player-audit.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:release": "npm run check && npm run test:browser && npm run smoke:runtime && npm run smoke:reconnect && npm run smoke:http && npm run stress:actions && npm run stress:socket"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "@upstash/redis": "^1.38.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.23.22",
    "helmet": "^8.1.0",
    "lucide-react": "^1.33.0",
    "nanoid": "^5.1.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
